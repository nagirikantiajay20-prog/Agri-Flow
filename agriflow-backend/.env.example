# ── App ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────
# Reuses the same Postgres instance the current Supabase project already
# runs on (see Master Plan Section 1.6 — a DATABASE_URL already exists and
# is used by agriflow-web's root maintenance scripts via the `pg` driver).
# Use the async driver form for SQLAlchemy's asyncpg engine:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agriflow
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/agriflow
# Supabase: runtime traffic goes through the TRANSACTION pooler (port 6543);
# migrations go through the SESSION pooler (port 5432). URL-encode special
# characters in the password (e.g. @ -> %40).
#   DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   DATABASE_URL_SYNC=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Disables asyncpg prepared-statement caching, which PgBouncer transaction
# mode does not support. Auto-detected from port 6543 when left unset.
# DB_USE_PGBOUNCER=true

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Redis (rate limiting, cache, ARQ jobs) ──────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── File storage (kept on Supabase Storage initially — see Master Plan §2) ─
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_DOCUMENTS=farmer-documents
STORAGE_BUCKET_VISITS=farm-visits
STORAGE_BUCKET_SEEDS=uploads
UPLOAD_MAX_SIZE_MB=10
UPLOAD_MAX_DOCUMENT_MB=5

# STORAGE_PROVIDER=s3 works with AWS S3 or any S3-compatible store. For
# Supabase Storage's S3 endpoint set
#   S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# and create the access keys under Project Settings -> Storage -> S3.
# Leave S3_PUBLIC_BASE_URL empty for private buckets (farmer KYC documents);
# reads are then served as short-lived signed URLs.
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_PRESIGN_EXPIRES_SECONDS=900

# ── Rate limiting (Redis-backed — replaces the client-side-only limiter
#    found in agriflow-web/src/utils/rateLimiter.js) ────────────────────
RATE_LIMIT_GLOBAL_PER_15MIN=900
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_AUTH_PER_15MIN=20
RATE_LIMIT_OTP_PER_MIN=3
RATE_LIMIT_WRITE_PER_5MIN=30
RATE_LIMIT_UPLOAD_PER_15MIN=10
RATE_LIMIT_ADMIN_PER_5MIN=100

# ── OTP (phone verification / password reset) ───────────────────────────
# No SMS provider is wired up yet; app/services/otp_service.deliver logs the
# code in development and refuses to run in production until one is added.
# OTP_ECHO_IN_RESPONSE returns the code in the API response for local
# development only — validate_for_production() rejects it in production.
OTP_ECHO_IN_RESPONSE=false
REQUIRE_REGISTRATION_OTP=false

# ── Caching & live updates (Redis-backed) ───────────────────────────────
CACHE_ENABLED=true
CACHE_TTL_PUBLIC_SECONDS=60
CACHE_TTL_DASHBOARD_SECONDS=10
LIVE_UPDATES_ENABLED=true

# ── Metrics ─────────────────────────────────────────────────────────────
METRICS_ENABLED=true

# ── Push notifications (Firebase Cloud Messaging) ──────────────────────
# Paste the service-account JSON (Firebase console -> Project settings ->
# Service accounts -> Generate new private key) into FIREBASE_CREDENTIALS_JSON,
# or mount it as a file and set FIREBASE_CREDENTIALS_PATH. Leave both empty
# to disable push; in-app notifications keep working either way.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=

# ── Weather advisory (Open-Meteo, no API key needed) ────────────────────
WEATHER_ENABLED=true
WEATHER_DEFAULT_LATITUDE=15.8281
WEATHER_DEFAULT_LONGITUDE=78.0373
WEATHER_CACHE_SECONDS=900

# ── Farmer app uploads ───────────────────────────────────────────────────
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_CROP_SCANS=crop-scans
UPLOAD_MAX_AVATAR_MB=2
